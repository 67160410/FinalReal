DB_PORT=3309
DB_USER=root
DB_PASSWORD=root
DB_NAME=exam_db

# secret สำหรับตรวจ JWT ของ token ทดสอบใน README-exam.md — ห้ามแก้
JWT_SECRET=final-exam-secret-2-2-5

# token ทดสอบ (role customer) คัดลอกจาก README-exam.md
CUSTOMER_TOKEN=

